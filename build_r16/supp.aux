\newlabel{tab:ext_validity}{{9}{4}{TSR on the second tool library (generic inference). Every agent drops from the i.i.d. validation split (1.00) to systematicity (0.43) and productivity (0.00 for template agents; 0.57 for ChainAware), and ChainAware is best on both compositional axes. Full per-agent values and the verdict are in \texttt {results/external\_validity.json}}{table.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Verdict and limitations.}{4}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Three-Way Ablation (Training $\times $ Detector $\times $ Scoring)}{5}{section.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Three-way ablation. Training is necessary for substitutability under equivalence-aware scoring (0.25 $\rightarrow $ 1.00); the variant detector is inert on the metric (1.00 with or without it); and the equivalence-aware evaluator supplies the remaining credit---under strict scoring ChainAware drops to 0.205. On productivity, ReAct's lenient call-everything behavior scores higher than ChainAware under both scoring regimes.}}{5}{table.10}\protected@file@percent }
\newlabel{tab:ablation_threeway}{{10}{5}{Three-way ablation. Training is necessary for substitutability under equivalence-aware scoring (0.25 $\rightarrow $ 1.00); the variant detector is inert on the metric (1.00 with or without it); and the equivalence-aware evaluator supplies the remaining credit---under strict scoring ChainAware drops to 0.205. On productivity, ReAct's lenient call-everything behavior scores higher than ChainAware under both scoring regimes}{table.10}{}}
