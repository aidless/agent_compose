\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Task Success Rate (TSR) on the 30-tool / 3{,}000-task AgentCompose benchmark. The four splits contain 400, 600, 600, and 200 instances, respectively. Template-agent rows report 5-seed means with min--max ranges (seed set 42, 1--4); both DeepSeek rows use 200 instances per split (1{,}600 tasks total) with bootstrap 95\% CIs. EquivAware extends ChainAware with equivalence-group detection; see Section~\ref {sec:equiv}. Bootstrap CIs and 5-seed variance accompany all rows (Supplementary Tables~\ref {tab:bootstrap_ci} and~\ref {tab:seed_variance}).}}{5}{table.3}\protected@file@percent }
\newlabel{tab:main}{{3}{5}{Task Success Rate (TSR) on the 30-tool / 3{,}000-task AgentCompose benchmark. The four splits contain 400, 600, 600, and 200 instances, respectively. Template-agent rows report 5-seed means with min--max ranges (seed set 42, 1--4); both DeepSeek rows use 200 instances per split (1{,}600 tasks total) with bootstrap 95\% CIs. EquivAware extends ChainAware with equivalence-group detection; see Section~\ref {sec:equiv}. Bootstrap CIs and 5-seed variance accompany all rows (Supplementary Tables~\ref {tab:bootstrap_ci} and~\ref {tab:seed_variance})}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Substitutability decomposed into true substitutions (159 tasks where a canonical tool is replaced by a functional equivalent) and controls (41 tasks whose chains contain no substitutable tool; these templates---e.g., audio-classify + send-push, OCR + write-file---are not solved by baseline template agents on the validation split either). ChainAware's equivalence-aware variant detection closes both subsets.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:sub_decomp}{{4}{5}{Substitutability decomposed into true substitutions (159 tasks where a canonical tool is replaced by a functional equivalent) and controls (41 tasks whose chains contain no substitutable tool; these templates---e.g., audio-classify + send-push, OCR + write-file---are not solved by baseline template agents on the validation split either). ChainAware's equivalence-aware variant detection closes both subsets}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Error-type breakdown for Native FC. Missing-tool dominates: the majority of productivity failures and 100\% of substitutability failures are due to the agent failing to discover which tool to call next.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:errors}{{2}{6}{Error-type breakdown for Native FC. Missing-tool dominates: the majority of productivity failures and 100\% of substitutability failures are due to the agent failing to discover which tool to call next}{figure.2}{}}
