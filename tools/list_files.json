{
  "name": "list_files",
  "domain": "file_io",
  "description": "List files in a directory with optional glob pattern. Returns matching file paths.",
  "parameters": {
    "type": "object",
    "properties": {
      "directory": {"type": "string"},
      "pattern": {"type": "string", "default": "*", "description": "Glob pattern, e.g., '*.csv'"}
    },
    "required": ["directory"]
  },
  "returns": {"type": "array", "items": {"type": "string"}},
  "side_effects": [],
  "failure_modes": ["directory_not_found"],
  "example_call": {"directory": "/data", "pattern": "*.csv"},
  "example_output": ["/data/numbers_a.csv", "/data/numbers_b.csv"]
}