{
  "name": "calendar_add",
  "domain": "scheduling",
  "description": "Add an event to a calendar at a specified time with optional duration and attendees.",
  "parameters": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Event title"
      },
      "start_time": {
        "type": "string",
        "description": "ISO 8601 start datetime"
      },
      "duration_minutes": {
        "type": "integer",
        "description": "Event duration in minutes",
        "default": 60
      },
      "attendees": {
        "type": "array",
        "items": {"type": "string"},
        "description": "List of attendee email addresses"
      }
    },
    "required": ["title", "start_time"]
  },
  "returns": {
    "type": "object",
    "properties": {
      "status": {"type": "string", "enum": ["created", "conflict", "failed"]},
      "event_id": {"type": "string"},
      "conflicts": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["status"]
  },
  "side_effects": ["calendar_write"],
  "failure_modes": ["conflict", "invalid_time", "permission_denied"],
  "example_call": {
    "title": "Team standup",
    "start_time": "2026-07-24T09:00:00Z",
    "duration_minutes": 30,
    "attendees": ["team@example.com"]
  },
  "example_output": {
    "status": "created",
    "event_id": "evt_2026_07_24_001",
    "conflicts": []
  }
}
