{
  "name": "search_web",
  "domain": "information_retrieval",
  "description": "Search the web for information given a natural language query. Returns a list of relevant results.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Natural language search query"
      },
      "max_results": {
        "type": "integer",
        "description": "Maximum number of results to return",
        "default": 5,
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": ["query"]
  },
  "returns": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "url": {"type": "string"},
        "snippet": {"type": "string"}
      },
      "required": ["title", "url", "snippet"]
    }
  },
  "side_effects": [],
  "failure_modes": ["network_error", "empty_results", "rate_limit"],
  "example_call": {
    "query": "weather in Tokyo today",
    "max_results": 3
  },
  "example_output": [
    {
      "title": "Tokyo Weather - 10 Day Forecast",
      "url": "https://weather.example.com/tokyo",
      "snippet": "Today's high 28°C, low 22°C, partly cloudy..."
    }
  ]
}
