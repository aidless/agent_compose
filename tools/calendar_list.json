{
  "name": "calendar_list",
  "domain": "scheduling",
  "description": "List calendar events within a date range.",
  "parameters": {
    "type": "object",
    "properties": {
      "start_date": {"type": "string", "description": "ISO 8601 date or datetime"},
      "end_date": {"type": "string"},
      "max_events": {"type": "integer", "default": 50, "minimum": 1, "maximum": 500}
    },
    "required": ["start_date", "end_date"]
  },
  "returns": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "start_time": {"type": "string"}, "end_time": {"type": "string"}}}},
  "side_effects": [],
  "failure_modes": ["invalid_range"],
  "example_call": {"start_date": "2026-08-01", "end_date": "2026-08-07", "max_events": 10},
  "example_output": [{"id": "evt_1", "title": "Team meeting", "start_time": "2026-08-02T10:00:00Z", "end_time": "2026-08-02T11:00:00Z"}]
}