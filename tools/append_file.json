{
  "name": "append_file",
  "domain": "file_io",
  "description": "Append text to an existing file. Creates the file if it does not exist.",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "description": "File path"},
      "content": {"type": "string", "description": "Text to append"}
    },
    "required": ["path", "content"]
  },
  "returns": {"type": "object", "properties": {"success": {"type": "boolean"}, "bytes_written": {"type": "integer"}}},
  "side_effects": ["filesystem_write"],
  "failure_modes": ["permission_denied", "disk_full"],
  "example_call": {"path": "/tmp/log.txt", "content": "New entry\\n"},
  "example_output": {"success": true, "bytes_written": 10}
}