{
  "name": "image_resize",
  "domain": "image_vision",
  "description": "Resize an image to specified dimensions. Returns the new image path.",
  "parameters": {
    "type": "object",
    "properties": {
      "source_path": {"type": "string"},
      "width": {"type": "integer", "minimum": 1, "maximum": 8192},
      "height": {"type": "integer", "minimum": 1, "maximum": 8192},
      "output_path": {"type": "string"}
    },
    "required": ["source_path", "width", "height", "output_path"]
  },
  "returns": {"type": "object", "properties": {"output_path": {"type": "string"}, "bytes": {"type": "integer"}}},
  "side_effects": ["filesystem_write"],
  "failure_modes": ["file_not_found", "unsupported_format"],
  "example_call": {"source_path": "/img/in.jpg", "width": 800, "height": 600, "output_path": "/img/out.jpg"},
  "example_output": {"output_path": "/img/out.jpg", "bytes": 123456}
}